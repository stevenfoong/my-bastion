#!/usr/bin/make -f
# Changed for My Bastion (2026). Derived from sol1/rustguac, Apache-2.0; see NOTICE.

export DH_VERBOSE = 1

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

# Everything is pre-built by build-deb.sh — no configure or build steps needed.
override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	# Create directory structure
	install -d debian/mybastion/opt/mybastion/bin
	install -d debian/mybastion/opt/mybastion/sbin
	install -d debian/mybastion/opt/mybastion/lib
	install -d debian/mybastion/opt/mybastion/static
	install -d debian/mybastion/opt/mybastion/static/guac
	install -d debian/mybastion/var/lib/mybastion
	install -d debian/mybastion/var/lib/mybastion/recordings
	install -d debian/mybastion/etc/mybastion/tls
	install -d debian/mybastion/etc/ld.so.conf.d

	# mybastion binary
	install -m 755 target/release/mybastion debian/mybastion/opt/mybastion/bin/mybastion

	# Drive setup helper script
	install -m 755 scripts/drive-setup.sh debian/mybastion/opt/mybastion/bin/drive-setup.sh

	# guacd binary and libraries from staging
	install -m 755 debian/staging/opt/mybastion/sbin/guacd debian/mybastion/opt/mybastion/sbin/guacd
	install -m 755 debian/staging/opt/mybastion/bin/guacenc debian/mybastion/opt/mybastion/bin/guacenc
	cp -a debian/staging/opt/mybastion/lib/*.so* debian/mybastion/opt/mybastion/lib/

	# FreeRDP plugin for RDPDR/RDPSND channels (drive redirection, audio, printing)
	install -d debian/mybastion/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3
	cp -a debian/staging/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3/*.so* debian/mybastion/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3/ 2>/dev/null || true

	# Static web assets
	cp -r static/* debian/mybastion/opt/mybastion/static/

	# Licence and attribution (Apache-2.0 requires NOTICE to travel with the work)
	install -d debian/mybastion/usr/share/doc/mybastion
	install -m 644 LICENSE NOTICE debian/mybastion/usr/share/doc/mybastion/

	# Default config (marked as conffile)
	install -m 644 debian/mybastion.toml.default debian/mybastion/etc/mybastion/mybastion.toml

	# ldconfig drop-in so guacd can find its libs
	echo "/opt/mybastion/lib" > debian/mybastion/etc/ld.so.conf.d/mybastion.conf

override_dh_shlibdeps:
	dh_shlibdeps -l/opt/mybastion/lib

# dh_dwz fails on Rust binaries
override_dh_dwz:

# Don't generate separate debug symbol packages
override_dh_strip:
	dh_strip --no-automatic-dbgsym

# Install both systemd services
override_dh_installsystemd:
	dh_installsystemd --name=mybastion-guacd
	dh_installsystemd --name=mybastion
