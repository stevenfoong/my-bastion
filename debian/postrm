#!/bin/sh
# Changed for My Bastion (2026). Derived from sol1/rustguac, Apache-2.0; see NOTICE.
set -e

# Update shared library cache
ldconfig

# On purge, remove runtime data and user
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/mybastion
    rm -rf /etc/mybastion/tls
    rm -rf /opt/mybastion
    rm -f /etc/ld.so.conf.d/mybastion.conf
    ldconfig

    if getent passwd mybastion >/dev/null 2>&1; then
        deluser --quiet --system mybastion || true
    fi
    if getent group mybastion >/dev/null 2>&1; then
        delgroup --quiet --system mybastion || true
    fi
fi

#DEBHELPER#

exit 0
