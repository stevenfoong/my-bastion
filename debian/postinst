#!/bin/sh
# Changed for My Bastion (2026). Derived from sol1/rustguac, Apache-2.0; see NOTICE.
set -e

# Data is the service's; config can hold secrets (OIDC client secret), so it
# is root-owned and only readable by the service group.
chown -R mybastion:mybastion /var/lib/mybastion
chown root:mybastion /etc/mybastion /etc/mybastion/mybastion.toml
chmod 750 /etc/mybastion
chmod 640 /etc/mybastion/mybastion.toml

# Key-encryption key for the SQLite secret store. Created once and never
# overwritten: secrets.db can only be opened with it.
if [ ! -f /etc/mybastion/kek ]; then
    (umask 277; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/mybastion/kek)
    chown mybastion:mybastion /etc/mybastion/kek
fi

# Chromium policy: web session hardening.
# DeveloperToolsAvailability=0: CDP needed for login scripts. Users can't reach DevTools
# through the UI anyway — chrome://* is in URLBlocklist.
mkdir -p /etc/chromium/policies/managed
cat > /etc/chromium/policies/managed/mybastion.json <<'POLICY'
{"AllowFileSelectionDialogs": false, "PasswordManagerEnabled": true, "ImportSavedPasswords": false, "DeveloperToolsAvailability": 0, "DownloadRestrictions": 3, "PrintingEnabled": false, "EditBookmarksEnabled": false, "BrowserSignin": 0, "SyncDisabled": true, "ExtensionInstallBlocklist": ["*"], "URLBlocklist": ["file://*", "chrome://*", "chrome-extension://*", "view-source:*", "javascript:*"], "URLAllowlist": ["chrome://policy"]}
POLICY

# Generate self-signed TLS certificate if none exists
if [ ! -f /etc/mybastion/tls/cert.pem ] || [ ! -f /etc/mybastion/tls/key.pem ]; then
    CERT_HOSTNAME=$(hostname -f 2>/dev/null || hostname)
    echo "Generating self-signed TLS certificate for ${CERT_HOSTNAME}..."
    /opt/mybastion/bin/mybastion generate-cert \
        --hostname "$CERT_HOSTNAME" \
        --out-dir /etc/mybastion/tls
    chmod 600 /etc/mybastion/tls/key.pem
    chmod 644 /etc/mybastion/tls/cert.pem
fi
chown -R mybastion:mybastion /etc/mybastion/tls

# Update shared library cache for guacd libs
ldconfig

echo ""
echo "  To set up encrypted file transfer (LUKS drive), run:"
echo "    sudo /opt/mybastion/bin/drive-setup.sh"
echo ""

#DEBHELPER#

exit 0
